<Window x:Class="ClipShare.Overlay.Views.AddServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Discord Server"
        Width="340" SizeToContent="Height" MinHeight="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="OnLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#12141F" />
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1B1F30" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#262B3F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2A46B8" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#3B5AD9" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEFF7" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8890A8" />

        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="DialogAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogPlainButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Color="Black" Opacity="0.5" />
        </Border.Effect>

        <Grid Margin="20,18,20,18">
            <!-- Every input row is Auto: the sole "*" row is the spacer *below* the fields,
                 so leftover space collapses there instead of squeezing a text box. Sizing
                 the Channel ID box with "*" previously shrank it to a few pixels tall,
                 leaving it visible but too thin to click into or type in. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Add Discord Server" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

            <TextBlock Grid.Row="1" Text="Server name" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="NameTextBox" Grid.Row="2" Style="{StaticResource DialogTextBoxStyle}" Margin="0,0,0,12" />

            <TextBlock Grid.Row="3" Text="Channel ID" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="ChannelIdTextBox" Grid.Row="4" Style="{StaticResource DialogTextBoxStyle}" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource DialogPlainButtonStyle}" Click="OnCancelClick" Margin="0,0,8,0" />
                <Button Content="Add" Style="{StaticResource DialogAccentButtonStyle}" Click="OnAddClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
